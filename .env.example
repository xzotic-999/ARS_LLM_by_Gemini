# ==============================================================================
# ARS_LLM — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local or cloud deployment:
#   cp .env.example .env
# NEVER commit real secrets, API keys, or production passwords to Git.

# --- Runtime & Unified Container Server ---
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY="false"
SERVE_STATIC_SPA="false"
AUTO_MIGRATE="false"

# --- PostgreSQL Database ---
# In cloud production, you may provide a single DATABASE_URL (e.g. Render, Neon, Supabase, Railway)
# OR discrete POSTGRES_* variables pointing to a non-local database host.
DATABASE_URL=""
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_DB="ars_llm_db"
POSTGRES_USER="ars_llm_user"
POSTGRES_PASSWORD="CHANGE_ME_POSTGRES_PASSWORD"
POSTGRES_SSL="false"
POSTGRES_SSL_REJECT_UNAUTHORIZED="true"
DB_URL="postgresql://ars_llm_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ars_llm_db"

# --- Session & Rate Limiting ---
SESSION_SECRET="CHANGE_ME_MIN_32_CHARS_SESSION_SECRET_KEY"
SESSION_MAX_AGE_MS="86400000"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="30"

# --- Quotas ---
DAILY_QUOTA_DEFAULT="20"
MONTHLY_QUOTA_DEFAULT="500"

# --- Initial Admin Bootstrap (Required on first DB initialization) ---
ADMIN_BOOTSTRAP_EMAIL="admin@ars_llm.local"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME_INITIAL_ADMIN_PASSWORD"
ADMIN_BOOTSTRAP_NAME="Administrator"

# --- FreeLLMAPI / Remote OpenAI-Compatible Provider (Server-Side Only — NEVER expose in VITE_*) ---
# Cloud / Dev Tunnel endpoint: https://v7skvft7-31415.euw.devtunnels.ms/v1
# Local Docker Desktop only:   http://host.docker.internal:31415/v1
# Note: In production (NODE_ENV=production), localhost, 127.0.0.1, and host.docker.internal are rejected.
# Provide FREELLM_API_KEY via environment secrets (never log or commit the real key).
FREELLM_API_BASE_URL="https://v7skvft7-31415.euw.devtunnels.ms/v1"
FREELLM_API_KEY="CHANGE_ME_FREELLM_API_KEY"
FREELLM_MODEL="auto"
FREELLM_TIMEOUT_MS="120000"

# --- Optional Secondary Cloud Failover Endpoint ---
FREELLM_FALLBACK_BASE_URL=""
FREELLM_FALLBACK_API_KEY=""
FREELLM_FALLBACK_MODEL="auto"

# --- AI Studio Compatibility Placeholder ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"


