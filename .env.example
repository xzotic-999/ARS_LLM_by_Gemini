# ==============================================================================
# ARS_LLM — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local or Docker Compose deployment.
# NEVER commit real secrets, API keys, or production passwords to Git.

# --- Runtime & Server ---
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"

# --- PostgreSQL Database ---
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_DB="ars_llm"
POSTGRES_USER="ars_llm_user"
POSTGRES_PASSWORD="CHANGE_ME_POSTGRES_PASSWORD"
DB_URL="postgresql://ars_llm_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ars_llm"

# --- Session & Rate Limiting ---
SESSION_SECRET="CHANGE_ME_MIN_32_CHARS_SESSION_SECRET_KEY"
SESSION_MAX_AGE_MS="86400000"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="30"

# --- Quotas ---
DAILY_QUOTA_DEFAULT="20"
MONTHLY_QUOTA_DEFAULT="500"

# --- Initial Admin Bootstrap ---
ADMIN_BOOTSTRAP_EMAIL="admin@ars_llm.local"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME_INITIAL_ADMIN_PASSWORD"
ADMIN_BOOTSTRAP_NAME="Administrator"

# --- FreeLLMAPI / Model Provider (Server-Side Only — NEVER expose in VITE_*) ---
FREELLM_API_BASE_URL="http://host.docker.internal:31415/v1"
FREELLM_API_KEY="CHANGE_ME_FREELLM_API_KEY"
FREELLM_MODEL="auto"

# --- AI Studio Compatibility Placeholder ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
